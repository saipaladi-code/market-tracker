# NewsAPI Key for live financial headline retrieval (Optional - falls back to rich demo dataset if blank)
NEWS_API_KEY=

# MongoDB Atlas connection string (Optional - falls back to local JSON persistence if blank or unreachable)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=financial_sentiment

# Google Gemini API Key for conversational AI news assistant (Optional - disabled gracefully if blank)
GEMINI_API_KEY=

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Force demo data flag (true/false)
USE_DEMO_DATA=false

# FinBERT model repository on Hugging Face (Serverless or local CPU inference)
MODEL_NAME=ProsusAI/finbert

# Hugging Face API Keys for genuine ProsusAI/finbert Serverless inference
# Supports up to 4 independent keys for rate limit (429) and auth (401/403) failover
HUGGINGFACE_API_KEY_1=
HUGGINGFACE_API_KEY_2=
HUGGINGFACE_API_KEY_3=
HUGGINGFACE_API_KEY_4=

# Set to true to run offline PyTorch sequence classification using local bfloat16 safetensors (zero API cost)
USE_LOCAL_FINBERT=false

# Authentication and Session Security
JWT_SECRET_KEY=change-to-a-strong-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_MINUTES=43200

# Optional SMTP Email Service for Password Recovery
# If left blank, automated password recovery informs users that email delivery is unconfigured
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true

